# Copy to .env and fill in real values per environment (or set these as
# actual environment variables in your hosting platform — this file is
# documentation either way; backend/server.js does not auto-load .env
# files, since that would add a dependency (dotenv) this project
# deliberately doesn't have. Export these yourself, e.g.:
#   export $(grep -v '^#' .env | xargs) && npm start
#
# The backend uses Node's built-in node:sqlite module. Run it on Node 24+
# (the supported runtime for this phase).

# Port the server listens on.
PORT=8787

# development | production. Affects error-message verbosity (5xx bodies
# never leak internals either way, but this is read for logging/health).
NODE_ENV=development

# Persistent data directory. SQLite and retained backups live here by
# default. Point this at a persistent volume in any deployment where the
# source tree itself isn't durable storage.
SELLIFY_DATA_DIR=./data

# Optional explicit SQLite path. Defaults to SELLIFY_DATA_DIR/sellify.sqlite.
SELLIFY_DB_PATH=./data/sellify.sqlite

# Optional backup directory. Defaults to SELLIFY_DATA_DIR/backups.
SELLIFY_BACKUP_DIR=./data/backups

# Number of rolling SQLite snapshots kept by `npm run backup`.
SELLIFY_BACKUP_RETENTION=7

# Required only for POST /admin/backup. Keep this in the hosting platform's
# secret manager; never put it in a data export or source file.
SELLIFY_BACKUP_TOKEN=

# Where the static PWA lives, for the backend to serve it directly.
# Defaults to ../app relative to backend/server.js (this project's
# layout) if unset. Set to a nonexistent path (or leave STATIC_DIR
# pointed somewhere empty) to run the backend as an API-only service —
# static serving is skipped automatically when the directory isn't found.
STATIC_DIR=./app

# Comma-separated list of origins allowed to call this API cross-origin,
# e.g. https://myshop.example.com,https://admin.example.com
# Required for a real deployment — an unset value falls back to
# allow-all (*) for local dev convenience, with a startup warning.
CORS_ALLOWED_ORIGINS=

# What /config.js tells the PWA to sync against. Leave unset when the
# backend also serves the app (STATIC_DIR set) — same-origin is inferred
# automatically per-request. Set explicitly only when the app is hosted
# separately from this backend (e.g. app on a CDN, backend elsewhere).
PUBLIC_SYNC_SERVER_URL=

# Simple in-memory per-IP rate limiting. Window in milliseconds, and max
# requests per window for writes (POST/PATCH) vs reads (GET, including
# static asset loads).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_WRITES=60
RATE_LIMIT_MAX_READS=300

# Leave unset/false unless this process runs behind a reverse proxy or
# load balancer you control. When true, the rate limiter keys on the
# left-most X-Forwarded-For address instead of the raw socket address.
# Do NOT enable this on a directly-exposed deployment — a client can set
# X-Forwarded-For itself and make the per-IP limiter a no-op.
TRUST_PROXY=false

# Telegram Mini App authentication. Required for /auth/telegram and the
# first-party onboarding flow. Store the bot token only on the backend.
TELEGRAM_BOT_TOKEN=

# Maximum age of Telegram initData accepted by /auth/telegram.
TELEGRAM_AUTH_MAX_AGE_SEC=86400

# Lifetime of tenant-scoped device sessions issued after authentication.
SELLIFY_SESSION_TTL_MS=604800000
