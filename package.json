{
  "name": "sellify",
  "version": "0.2.0",
  "private": true,
  "description": "Sellify: offline-first PWA (app/) + multi-tenant sync backend (backend/). See README.md for the deployment layout and environment variables.",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "start:backend": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:app": "npm --prefix app run dev",
    "backup": "npm --prefix backend run backup",
    "phase0:baseline": "bash scripts/phase0-baseline.sh",
    "phase0:test": "node phase0/golden-regression.mjs",
    "phase0:release-check": "bash scripts/phase0-release-check.sh",
    "test:outbox-tenant-scope": "node phase0/event-outbox-tenant-scope-regression.mjs",
    "test:offline-outbox-recovery-journal": "node phase0/offline-outbox-recovery-journal-regression.mjs",
    "test:first-experience-returning-merchant": "node phase0/first-experience-returning-merchant-regression.mjs",
    "test:first-experience-add-availability": "node phase0/first-experience-add-availability-regression.mjs",
    "test:first-experience-home-readiness": "node phase0/first-experience-home-readiness-regression.mjs",
    "test:first-experience-pack-readiness": "node phase0/first-experience-pack-readiness-regression.mjs",
    "test:first-experience-channel-compatibility": "node phase0/first-experience-channel-compatibility-regression.mjs",
    "test:first-experience-ecosystem-discovery": "node phase0/first-experience-ecosystem-discovery-regression.mjs",
    "test:browser-module-serving": "node phase0/browser-module-serving-regression.mjs",
    "test:browser-module-serving-http": "node phase0/browser-module-serving-http-regression.mjs",
    "test:browser-module-serving-production-http": "node phase0/browser-module-serving-production-http-regression.mjs",
    "test:browser-module-serving-browser": "node phase0/browser-module-serving-browser-smoke.mjs",
    "test:gap-2-inventory-exactly-once": "node phase0/gap-2-inventory-exactly-once-regression.mjs",
    "test:service-catalog-http": "node phase0/first-experience-service-catalog-http-regression.mjs",
    "test:service-catalog-frontend-sync": "node phase0/first-experience-service-catalog-frontend-sync-regression.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
