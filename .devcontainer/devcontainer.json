{
  "name": "Sellify UI Evaluation",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "forwardPorts": [
    3000,
    8787
  ],
  "portsAttributes": {
    "3000": {
      "label": "Sellify frontend development preview",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8787": {
      "label": "Sellify application preview",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm ci --ignore-scripts && npx playwright install --with-deps chromium",
  "remoteUser": "node"
}
